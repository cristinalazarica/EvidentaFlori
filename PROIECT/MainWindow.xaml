<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Florărie"
        MinWidth="900"
        MinHeight="600"
        Background="#F7F7F7">

    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#D86C8A"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENIU -->
        <StackPanel Background="{StaticResource Primary}">
            <TextBlock Text="🌸 Florărie"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="10"
                       HorizontalAlignment="Center"/>

            <Button Content="Admin" Click="BtnAdmin_Click"/>
            <Button Content="Cautare" Click="BtnCauta_Click"/>
        </StackPanel>

        <!-- CONTINUT -->
        <Grid Grid.Column="1">

            <TabControl x:Name="panelAdmin" Margin="15">

                <!-- FLORI -->
                <TabItem Header="Flori">
                    <StackPanel Width="350">
                        <TextBlock Text=" Floare"/>
                        <TextBox x:Name="txtNume"/>
                        <TextBlock Text="Pret"/>
                        <TextBox x:Name="txtPret"/>
                        <TextBlock Text="Stoc"/>
                        <TextBox x:Name="txtStoc"/>

                        <ComboBox x:Name="cmbCuloareFlori">
                            <TextBlock Text="Culoare"/>
                            <ComboBoxItem Content="Rosu"/>
                            <ComboBoxItem Content="Alb"/>
                            <ComboBoxItem Content="Galben"/>
                            <ComboBoxItem Content="Mov"/>
                        </ComboBox>

                        <ListBox x:Name="lstTipFloare" Height="70">
                            <ListBoxItem Content="Buchet"/>
                            <ListBoxItem Content="Ghiveci"/>
                            <ListBoxItem Content="Decoratiune"/>
                        </ListBox>

                        <DatePicker x:Name="dpDataAdaugare"/>

                        <CheckBox x:Name="chkParfumata" Content="Parfumata"/>
                        <CheckBox x:Name="chkDecorativa" Content="Decorativa"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaFloare_Click"/>

                    </StackPanel>
                </TabItem>

                <!-- CLIENTI -->
                <TabItem Header="Clienti" HorizontalAlignment="Right" Margin="0,-2,-2,0" Width="49">

                    <StackPanel Width="320">

                        <TextBox x:Name="txtNumeClient"/>
                        <TextBox x:Name="txtNrComenzi"/>

                        <Button Content="Adauga Client"
                                Click="BtnAdaugaClient_Click"/>

                        <Button Content="Edit Client"
                                Click="BtnEditClient_Click"/>

                        <Button Content="Sterge Client"
                                Click="BtnStergeClient_Click"/>

                        <ListBox x:Name="lstClienti" Height="200"/>

                    </StackPanel>

                </TabItem>

                <!-- COMENZI -->
                <TabItem Header="Comenzi">

                    <StackPanel Width="320">

                        <TextBox x:Name="txtNumeClientComanda"/>
                        <TextBox x:Name="txtNumeFloareComanda"/>
                        <TextBox x:Name="txtCantitate"/>

                        <Button Content="Adauga Comanda"
                                Click="BtnAdaugaComanda_Click"/>

                        <DataGrid x:Name="dgComenzi" Height="200"/>

                    </StackPanel>

                </TabItem>

            </TabControl>

            <!-- CAUTARE -->
            <StackPanel x:Name="panelCautare"
                        Visibility="Collapsed"
                        Margin="15">

                <TextBox x:Name="txtCautareNume"/>
                <TextBox x:Name="txtCautarePret"/>

                <ComboBox x:Name="cmbCuloareCautare">
                    <ComboBoxItem Content="Rosu"/>
                    <ComboBoxItem Content="Alb"/>
                    <ComboBoxItem Content="Galben"/>
                    <ComboBoxItem Content="Mov"/>
                </ComboBox>

                <Button Content="Cauta"
                        Click="BtnCautareAvansata_Click"/>

                <DataGrid x:Name="dgFlori" Height="300"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>