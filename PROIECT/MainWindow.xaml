<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Florărie"
        MinWidth="800" MinHeight="500"
        Background="#F5F5F5">

    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#C97C8A"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENIU -->
        <StackPanel Background="{StaticResource Primary}">
            <TextBlock Text="🌸 Florărie"
                       Foreground="White"
                       FontSize="20"
                       Margin="10"
                       HorizontalAlignment="Center"/>

            <Button Content="Admin" Click="BtnAdmin_Click"/>
            <Button Content="Cautare" Click="BtnCauta_Click"/>
        </StackPanel>

        <!-- CONTINUT -->
        <Grid Grid.Column="1">

            <!-- ADMIN -->
            <TabControl x:Name="panelAdmin" Margin="20">

                <!-- FLORI -->
                <TabItem Header="Flori">
                    <StackPanel Width="320">

                        <TextBlock Text="Nume"/>
                        <TextBox x:Name="txtNume"/>

                        <TextBlock Text="Pret"/>
                        <TextBox x:Name="txtPret"/>

                        <TextBlock Text="Stoc"/>
                        <TextBox x:Name="txtStoc"/>

                        <TextBlock Text="Culoare"/>
                        <ComboBox x:Name="cmbCuloare">
                            <ComboBoxItem Content="Rosu"/>
                            <ComboBoxItem Content="Alb"/>
                            <ComboBoxItem Content="Galben"/>
                            <ComboBoxItem Content="Mov"/>
                            <ComboBoxItem Content="Albastru"/>
                        </ComboBox>

                        <TextBlock Text="Tip"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Naturala" GroupName="Tip" IsChecked="True"/>
                            <RadioButton Content="Artificiala" GroupName="Tip"/>
                        </StackPanel>

                        <CheckBox x:Name="chkParfumata" Content="Parfumata"/>
                        <CheckBox x:Name="chkDecorativa" Content="Decorativa"/>

                        <Button Content="Adauga / Modifica"
                                Click="BtnAdaugaFloare_Click"/>

                        <TextBlock x:Name="txtEroareFloare" Foreground="Red"/>

                    </StackPanel>
                </TabItem>

                <!-- CLIENTI -->
                <TabItem Header="Clienti">
                    <StackPanel Width="320">

                        <TextBlock Text="Nume"/>
                        <TextBox x:Name="txtNumeClient"/>

                        <TextBlock Text="Nr comenzi"/>
                        <TextBox x:Name="txtNrComenzi"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaClient_Click"/>

                        <TextBlock x:Name="txtEroareClient" Foreground="Red"/>

                    </StackPanel>
                </TabItem>

                <!-- COMENZI -->
                <TabItem Header="Comenzi">
                    <StackPanel Width="320">

                        <TextBlock Text="Client"/>
                        <TextBox x:Name="txtNumeClientComanda"/>

                        <TextBlock Text="Floare"/>
                        <TextBox x:Name="txtNumeFloareComanda"/>

                        <TextBlock Text="Cantitate"/>
                        <TextBox x:Name="txtCantitate"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaComanda_Click"/>

                        <TextBlock x:Name="txtEroareComanda" Foreground="Red"/>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- CAUTARE -->
            <StackPanel x:Name="panelCautare"
                        Visibility="Collapsed"
                        Margin="20">

                <TextBlock Text="Cautare floare"/>
                <TextBox x:Name="txtCautare" Width="200"/>

                <Button Content="Cauta"
                        Click="BtnCautaFloare_Click"
                        Width="100"/>

                <TextBlock x:Name="lblRezultatCautare" Foreground="Red"/>

                <!-- DATA GRID -->
                <DataGrid x:Name="dgFlori"
                          AutoGenerateColumns="False"
                          Height="300">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
                        <DataGridTextColumn Header="Pret" Binding="{Binding Pret}" Width="*"/>
                        <DataGridTextColumn Header="Stoc" Binding="{Binding Stoc}" Width="*"/>
                        <DataGridTextColumn Header="Culoare" Binding="{Binding Culoare}" Width="*"/>
                        <DataGridTextColumn Header="Optiuni" Binding="{Binding Optiuni}" Width="*"/>

                        <DataGridTemplateColumn Header="Edit">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Edit"
                                            Click="BtnEdit_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Delete">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete"
                                            Background="Red"
                                            Click="BtnDelete_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>

        </Grid>
    </Grid>
</Window>