<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Florărie"
        MinWidth="900"
        MinHeight="600"
        Background="#F5F5F5">

    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#C97C8A"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="{StaticResource Primary}">

            <TextBlock Text="🌸 Florărie"
                       Foreground="White"
                       FontSize="22"
                       Margin="10"
                       HorizontalAlignment="Center"/>

            <Button Content="Admin"
                    Click="BtnAdmin_Click"/>

            <Button Content="Cautare"
                    Click="BtnCauta_Click"/>

        </StackPanel>

        <Grid Grid.Column="1">

            <TabControl x:Name="panelAdmin"
                        Margin="20">

                <TabItem Header="Flori">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Width="360">

                            <TextBlock Text="Nume floare"/>
                            <TextBox x:Name="txtNume"/>

                            <TextBlock Text="Pret"/>
                            <TextBox x:Name="txtPret"/>

                            <TextBlock Text="Stoc"/>
                            <TextBox x:Name="txtStoc"/>

                            <TextBlock Text="Culoare"/>

                            <ComboBox x:Name="cmbCuloare"
                                      Margin="5"
                                      Height="30">

                                <ComboBoxItem Content="Rosu"/>
                                <ComboBoxItem Content="Alb"/>
                                <ComboBoxItem Content="Galben"/>
                                <ComboBoxItem Content="Mov"/>
                                <ComboBoxItem Content="Albastru"/>

                            </ComboBox>

                            <TextBlock Text="Selectează tipul florii"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="5,10,5,5"/>

                            <ListBox x:Name="lstTipFloare"
                                     Height="68"
                                     SelectionMode="Single"
                                     Margin="5">
                                <ListBoxItem Content="Buchet"/>
                                <ListBoxItem Content="Ghiveci"/>
                                <ListBoxItem Content="Decoratiune"/>
                            </ListBox>

                            <Border Background="#FFF8FA"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="5"
                                    BorderBrush="#C97C8A"
                                    BorderThickness="2">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,10">

                                        <TextBlock Text="📅"
                                                   FontSize="18"
                                                   Margin="0,0,5,0"/>

                                        <TextBlock Text="Data adăugării florii"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#444444"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                    <Border Background="White"
                                            CornerRadius="8"
                                            Padding="5"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1">

                                        <DatePicker x:Name="dpDataAdaugare"
                                                    Height="35"
                                                    FontSize="14"
                                                    SelectedDateFormat="Short"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Center"/>

                                    </Border>

                                </StackPanel>

                            </Border>

                            <CheckBox x:Name="chkParfumata"
                                      Content="Parfumata"
                                      Margin="5"/>

                            <CheckBox x:Name="chkDecorativa"
                                      Content="Decorativa"
                                      Margin="5"/>

                            <Button Content="Adauga / Modifica"
                                    Click="BtnAdaugaFloare_Click"/>

                            <TextBlock x:Name="txtEroareFloare"
                                       Foreground="Red"
                                       Margin="5"/>

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>

                <TabItem Header="Clienti">

                    <StackPanel Width="320">

                        <TextBlock Text="Nume"/>
                        <TextBox x:Name="txtNumeClient"/>

                        <TextBlock Text="Nr comenzi"/>
                        <TextBox x:Name="txtNrComenzi"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaClient_Click"/>

                        <TextBlock x:Name="txtEroareClient"
                                   Foreground="Red"/>

                    </StackPanel>

                </TabItem>

                <TabItem Header="Comenzi">

                    <StackPanel Width="320">

                        <TextBlock Text="Client"/>
                        <TextBox x:Name="txtNumeClientComanda"/>

                        <TextBlock Text="Floare"/>
                        <TextBox x:Name="txtNumeFloareComanda"/>

                        <TextBlock Text="Cantitate"/>
                        <TextBox x:Name="txtCantitate"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaComanda_Click"/>

                        <TextBlock x:Name="txtEroareComanda"
                                   Foreground="Red"/>

                    </StackPanel>

                </TabItem>

            </TabControl>

            <StackPanel x:Name="panelCautare"
                        Visibility="Collapsed"
                        Margin="20">

                <TextBlock Text="Cautare floare"/>

                <TextBox x:Name="txtCautare"
                         Width="200"/>

                <Button Content="Cauta"
                        Width="100"
                        Click="BtnCautaFloare_Click"/>

                <DataGrid x:Name="dgFlori"
                          AutoGenerateColumns="False"
                          Height="350"
                          Margin="5">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Nume"
                                            Binding="{Binding Nume}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Pret"
                                            Binding="{Binding Pret}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Stoc"
                                            Binding="{Binding Stoc}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Culoare"
                                            Binding="{Binding Culoare}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Optiuni"
                                            Binding="{Binding Optiuni}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Tip"
                                            Binding="{Binding TipFloare}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding DataAdaugare}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Actualizare"
                                            Binding="{Binding DataActualizare}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="Edit">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="Edit"
                                            Click="BtnEdit_Click"
                                            Tag="{Binding}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Delete">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="Delete"
                                            Background="Red"
                                            Click="BtnDelete_Click"
                                            Tag="{Binding}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Grid>

    </Grid>

</Window>