<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="900"
        WindowState="Maximized"
        Title="Florărie"
        Background="#FFF8F5F7">

    <Window.Resources>

        <!-- CULORI -->
        <SolidColorBrush x:Key="Primary" Color="#C97C8A"/>
        <SolidColorBrush x:Key="Secondary" Color="#E7B7C2"/>
        <SolidColorBrush x:Key="TextDark" Color="#3A3A3A"/>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E7B7C2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- LABEL -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- BUTTON -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TAB -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>

    </Window.Resources>

    <Grid>

        <StackPanel>

            <!-- HEADER -->
            <Border Background="{StaticResource Primary}" Padding="18">
                <TextBlock Text="🌸 Florărie"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- TABS -->
            <TabControl Margin="25" Background="Transparent">

                <!-- FLORI -->
                <TabItem Header="Flori">
                    <Border Background="White" CornerRadius="14" Padding="35" Margin="10">

                        <StackPanel Width="360" HorizontalAlignment="Center">

                            <TextBlock Text="Adaugă Floare"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>

                            <Label x:Name="lblNume" Content="Nume floare"/>
                            <TextBox x:Name="txtNume"/>

                            <Label x:Name="lblPret" Content="Preț"/>
                            <TextBox x:Name="txtPret"/>

                            <Label x:Name="lblStoc" Content="Stoc"/>
                            <TextBox x:Name="txtStoc"/>

                            <Label x:Name="lblCuloare" Content="Culoare"/>

                            <ComboBox x:Name="cmbCuloare"
          Margin="0,0,0,8"
          Padding="8,6"
          FontSize="14">

                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                                        <TextBlock Text="Rosu"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="White" Stroke="Black" Margin="0,0,8,0"/>
                                        <TextBlock Text="Alb"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="Yellow" Margin="0,0,8,0"/>
                                        <TextBlock Text="Galben"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="Purple" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mov"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="Blue" Margin="0,0,8,0"/>
                                        <TextBlock Text="Albastru"/>
                                    </StackPanel>
                                </ComboBoxItem>

                            </ComboBox>

                            <CheckBox x:Name="chkParfumata" Content="Parfumată"/>
                            <CheckBox x:Name="chkDecorativa" Content="Decorativă"/>

                            <Button Content="Adaugă"
                                    Background="{StaticResource Primary}"
                                    Click="BtnAdaugaFloare_Click"
                                    Margin="0,10,0,0"/>

                            <Button Content="Reset"
                                    Background="{StaticResource Secondary}"
                                    Click="BtnResetFloare_Click"
                                    Margin="0,5,0,0"/>

                            <TextBlock x:Name="txtEroareFloare"
                                       Foreground="Red"
                                       Margin="0,10,0,0"/>

                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- CLIENTI -->
                <TabItem Header="Clienți">
                    <Border Background="White" CornerRadius="14" Padding="35" Margin="10">

                        <StackPanel Width="360" HorizontalAlignment="Center">

                            <TextBlock Text="Adaugă Client"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>

                            <Label x:Name="lblNumeClient" Content="Nume"/>
                            <TextBox x:Name="txtNumeClient"/>

                            <Label x:Name="lblNrComenzi" Content="Nr. comenzi"/>
                            <TextBox x:Name="txtNrComenzi"/>

                            <Button Content="Adaugă"
                                    Background="{StaticResource Primary}"
                                    Click="BtnAdaugaClient_Click"
                                    Margin="0,10,0,0"/>

                            <TextBlock x:Name="txtEroareClient"
                                       Foreground="Red"
                                       Margin="0,10,0,0"/>

                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- COMENZI -->
                <TabItem Header="Comenzi">
                    <Border Background="White" CornerRadius="14" Padding="35" Margin="10">

                        <StackPanel Width="360" HorizontalAlignment="Center">

                            <TextBlock Text="Adaugă Comandă"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>

                            <Label x:Name="lblNumeClientComanda" Content="Client"/>
                            <TextBox x:Name="txtNumeClientComanda"/>

                            <Label x:Name="lblNumeFloareComanda" Content="Floare"/>
                            <TextBox x:Name="txtNumeFloareComanda"/>

                            <Label x:Name="lblCantitate" Content="Cantitate"/>
                            <TextBox x:Name="txtCantitate"/>

                            <Button Content="Adaugă"
                                    Background="{StaticResource Primary}"
                                    Click="BtnAdaugaComanda_Click"
                                    Margin="0,10,0,0"/>

                            <TextBlock x:Name="txtEroareComanda"
                                       Foreground="Red"
                                       Margin="0,10,0,0"/>

                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>

        </StackPanel>
    </Grid>
</Window>