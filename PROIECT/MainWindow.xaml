<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Florărie"
        MinWidth="900"
        MinHeight="600"
        Background="#FFF5F7">

    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#D86C8A"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#F3A6B8"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF0F3"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENIU -->
        <StackPanel Background="{StaticResource Primary}">
            <TextBlock Text="🌸 Florărie"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="10"
                       HorizontalAlignment="Center"/>

            <Button Content="Admin" Click="BtnAdmin_Click"/>
            <Button Content="Cautare" Click="BtnCauta_Click"/>
        </StackPanel>

        <!-- CONTINUT -->
        <Grid Grid.Column="1">

            <!-- ADMIN -->
            <TabControl x:Name="panelAdmin" Margin="15">

                <!-- FLORI -->
                <TabItem Header="Flori">
                    <StackPanel Width="350">

                        <TextBlock Text="Nume"/>
                        <TextBox x:Name="txtNume"/>

                        <TextBlock Text="Pret"/>
                        <TextBox x:Name="txtPret"/>

                        <TextBlock Text="Stoc"/>
                        <TextBox x:Name="txtStoc"/>

                        <TextBlock Text="Culoare"/>
                        <ComboBox x:Name="cmbCuloareFlori" SelectedIndex="0">
                            <ComboBoxItem Content="Rosu"/>
                            <ComboBoxItem Content="Alb"/>
                            <ComboBoxItem Content="Galben"/>
                            <ComboBoxItem Content="Mov"/>
                        </ComboBox>

                        <ListBox x:Name="lstTipFloare" Height="70">
                            <ListBoxItem Content="Buchet"/>
                            <ListBoxItem Content="Ghiveci"/>
                            <ListBoxItem Content="Decoratiune"/>
                        </ListBox>

                        <CheckBox x:Name="chkParfumata" Content="Parfumata"/>
                        <CheckBox x:Name="chkDecorativa" Content="Decorativa"/>

                        <Button Content="Adauga"
                                Click="BtnAdaugaFloare_Click"/>

                    </StackPanel>
                </TabItem>

                <!-- CLIENTI -->
                <TabItem Header="Clienti">
                    <StackPanel Width="320">

                        <TextBlock Text="Nume client"/>
                        <TextBox x:Name="txtNumeClient"/>

                        <TextBlock Text="Numar comenzi"/>
                        <TextBox x:Name="txtNrComenzi"/>

                        <Button Content="Adauga Client"
                                Click="BtnAdaugaClient_Click"/>

                        <Button Content="Edit Client"
                                Click="BtnEditClient_Click"/>

                        <Button Content="Sterge Client"
                                Click="BtnStergeClient_Click"/>

                        <ListBox x:Name="lstClienti"
                                 DisplayMemberPath="Nume"
                                 Height="200"/>
                    </StackPanel>
                </TabItem>

                <!-- COMENZI -->
                <TabItem Header="Comenzi">
                    <StackPanel Width="320">

                        <TextBlock Text="Nume client"/>
                        <TextBox x:Name="txtNumeClientComanda"/>

                        <TextBlock Text="Nume floare"/>
                        <TextBox x:Name="txtNumeFloareComanda"/>

                        <TextBlock Text="Cantitate"/>
                        <TextBox x:Name="txtCantitate"/>

                        <Button Content="Adauga Comanda"
                                Click="BtnAdaugaComanda_Click"/>

                        <DataGrid x:Name="dgComenzi"
                                  Height="200"
                                  AutoGenerateColumns="True"/>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- CAUTARE (AICI ESTE AFISAREA FLORILOR) -->
            <StackPanel x:Name="panelCautare"
                        Visibility="Collapsed"
                        Margin="15">

                <TextBlock Text="Cautare flori"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBox x:Name="txtCautareNume" />
                <TextBox x:Name="txtCautarePret" />

                <ComboBox x:Name="cmbCuloareCautare" SelectedIndex="0">
                    <ComboBoxItem Content="Rosu"/>
                    <ComboBoxItem Content="Alb"/>
                    <ComboBoxItem Content="Galben"/>
                    <ComboBoxItem Content="Mov"/>
                </ComboBox>

                <Button Content="Cauta"
                        Click="BtnCautareAvansata_Click"/>

                <!-- 🔥 AFISARE FLORI MUTATA AICI -->
                <TextBlock Text="Rezultate flori"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="5"/>

                <DataGrid x:Name="dgFloriCautare"
                          Height="300"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>